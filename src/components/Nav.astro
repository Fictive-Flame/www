---
import Container from "./Container.astro";
const classes = Astro.props.classes || [];
---

<nav
  x-data="{ open: false }"
  @scroll.window="open = (window.pageYOffset > 50 ? false : true)"
  class="fixed top-0 z-50 w-full bg-gray-950 text-gray-300"
>
  <Container classes={["flex", "py-6", "px-6", "justify-between"]}>
    <div>
      <span class="flex">
        <a class="uppercase font-bold" href="/">Fictive Flame</a>
        <svg
          height="25px"
          width="25px"
          viewBox="0 0 100 100"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
        >
          <defs>
            <linearGradient
              id="flameGradient"
              x1="0"
              y1="0"
              x2="0"
              y2="128"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0%" stop-color="#FF6A00"></stop>
              <stop offset="50%" stop-color="#FF8C00"></stop>
              <stop offset="100%" stop-color="#FFD700"></stop>
            </linearGradient>
          </defs>
          <path
            d="M64 8c-4 12-16 20-20 36s0 32 20 44c20-12 24-28 20-44s-16-24-20-36z"
            fill="url(#flameGradient)"></path>
          <path
            d="M64 92c12-8 16-18 12-28s-12-14-12-22c-4 6-8 10-10 18-2 10 2 20 10 32z"
            fill="#FF4500"></path>
        </svg>
      </span>
    </div>
    <ul class="flex uppercase font-light">
      <li>
        <a class="me-4 underline-offset-8 hover:underline" href="/work">Work</a>
      </li>
      <li>
        <a class="me-4 underline-offset-8 hover:underline" href="/about"
          >About</a
        >
      </li>
      <li>
        <a class="me-4 underline-offset-8 hover:underline" href="#contact"
          >Contact</a
        >
      </li>
    </ul>
  </Container>
</nav>
