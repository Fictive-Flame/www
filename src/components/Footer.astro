<footer
  id="contact"
  class="mt-12 mb-8 container px-6 mx-auto transition duration-300 lg:px-0"
>
  <div class="outline-1 outline-gray-400 p-8 rounded-2xl">
    <div class="text-center">
      <div class="text-2xl font-bold text-gray-600 lg:text-6xl">Contact Us</div>
      <p class="text-wrap text-xl font-light mt-8">
        You have a story. We have the gear and the goods, so why not reach out?
      </p>
    </div>
    <div class="py-8 lg:py-16 px-4 mx-auto max-w-screen-md">
      <form
        x-data="buildContactForm()"
        @submit.prevent="submit"
        action="https://www.formbackend.com/f/61a483e23fd551e1"
        method="POST"
        class="space-y-8"
      >
        <div
          class="text-2xl font-bold text-gray-600 text-center lg:text-4xl transition duration-300"
          x-show="submitted"
        >
          We've received your request and will be in touch soon. Thank you!
        </div>
        <div x-show="!submitted">
          <label class="block mb-2 text-gray-900">Name</label>
          <input
            type="text"
            name="name"
            x-model="data.name"
            class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5"
            placeholder="Your Name"
            required
          />
        </div>
        <div x-show="!submitted">
          <label class="block mb-2 text-gray-900">Email Address</label>
          <input
            type="email"
            name="email"
            x-model="data.email"
            class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5"
            placeholder="nicholas@fictiveflame.co"
            required
          />
        </div>
        <div x-show="!submitted">
          <label class="block mb-2 text-gray-900">Message</label>
          <textarea
            name="message"
            x-model="data.message"
            rows="6"
            class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg shadow-sm border border-gray-300 focus:ring-primary-500 focus:border-primary-500"
            placeholder="Tell us about your needs..."></textarea>
        </div>
        <button
          type="submit"
          :disabled="loading"
          x-show="!submitted"
          class="py-3 px-5 outline-1 outline-gray-900 rounded-lg cursor-pointer sm:w-fit hover:bg-primary-800 focus:ring-4 focus:outline-none focus:ring-primary-300"
          >Send</button
        >
      </form>
    </div>
  </div>
  <p class="mt-8 text-center text-gray-700 align-bottom antialiased text-sm">
    &copy; 2025 Fictive Flame Media. All rights reserved.
  </p>
</footer>
<script is:inline>
  function buildContactForm() {
    return {
      loading: false,
      submitted: false,
      data: {
        name: "",
        email: "",
        message: "",
      },
      submit() {
        this.loading = true;

        fetch("https://www.formbackend.com/f/61a483e23fd551e1", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(this.data),
        })
          .then((response) => {
            if (response.status === 422) {
              throw new Error("Validation error");
            } else if (!response.ok) {
              throw new Error("Something went wrong");
            }

            return response.json();
          })
          .then((data) => {
            this.submitted = true;
            this.loading = false;
          })
          .catch((error) => {
            console.error("Error:", error);
          });
      },
    };
  }
</script>
