---
import { slugify, workUrlFor } from "../utils/data";
const { data: { title, categories, poster, preview, media } } = Astro.props;
---
<div class="overflow-hidden relative h-[500px]">
    <div class="absolute flex w-full h-full items-end z-12 p-4">
        <div>
            <a href={workUrlFor(title)}>
                <h2 class="text-2xl text-gray-300 font-bold">
                    <span class="absolute h-full w-full inset-0"></span>
                    {title}
                </h2>
            </a>
            <ul class="flex flex-wrap items-center mt-4 text-gray-100 text-sm">
                {categories.map(c => (
                    <li class="bg-gray-700 backdrop-opacity-40 rounded-2xl me-2">
                        <a class="p-2 inline-block" href=`/work/category/${slugify(c)}`>{c}</a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
    <div
        class="absolute w-full h-4/5 bottom-0 z-11 bg-gradient-to-b from-gray-950/0 to-gray-950/90"
    >
    </div>
    <video
        autoplay
        loop
        muted
        playsinline
        poster={poster}
        class="absolute inset-0 z-10 h-full w-full object-cover"
    >
        {preview.map(p => (<source src={p.src} type={p.type} />))}
    </video>
</div>
