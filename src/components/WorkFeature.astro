---
const { data: { title, preview }} = Astro.props;
---
<div class="overflow-hidden relative h-96 rounded-2xl">
    <video
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 h-full w-full object-cover"
    >
        {preview.map(p => (
          <source src={p.src} type={p.type} />
        ))}
    </video>
</div>
