---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Container from "../../components/Container.astro";
import Footer from "../../components/Footer.astro";
import { getPosts } from "../../utils/data";

const posts = await getPosts();
---

<Layout title={`Blog`}>
  <Nav />
  <SectionHeader>
    <Container classes={["px-6", "lg:px-0"]}>
      <span
        class="flex text-4xl text-gray-700 dark:text-gray-300 font-bold mb-8 lg:text-8xl"
      >
        <a class="underline underline-offset-4" href="/work"><h2>Work</h2></a>/
        <a href="/blog">
          <h1 class="text-gray-800 dark:text-gray-400">Blog</h1>
        </a>
      </span>
    </Container>
  </SectionHeader>
  <div class="mx-auto grid mt-12 grid-cols-12">
    <Container
      classes={[
        "px-6",
        "col-span-1",
        "lg:px-0",
        "lg:col-span-8",
        "text-sm",
        "uppercase",
        "mb-2",
      ]}
    >
      {
        posts.map((p) => (
          <a href={`/posts/${p.id}`}>
            <h2 class="text-3xl">{p.data.title}</h2>
          </a>
        ))
      }
    </Container>
    <aside class="col-span-1 lg:col-span-4">
      <div class="mb-2 dark:text-gray-300"><span>Categories</span></div>
      <ul class="flex overflow-y-scroll dark:text-gray-300"></ul>
    </aside>
  </div>
  <Footer />
</Layout>
