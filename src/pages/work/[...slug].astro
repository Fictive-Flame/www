---
import { getCollection } from "astro:content";
import { basename } from "path";
import { getWork, slugify } from "../../utils/data";
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map(w => ({
    params: { slug: slugify(w.data.title) },
    props: w,
  }))
}

const { data: { title, preview } } = Astro.props;
---
<Layout>
    <div class="relative">
        <h2 class="text-6xl text-gray-300">{title}</h2>
        <p>Coming Soon...</p>
    </div>
</Layout>
