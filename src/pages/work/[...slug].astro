---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Container from "../../components/Container.astro";
import Footer from "../../components/Footer.astro";

import { getWork, slugify } from "../../utils/data";

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((w) => ({
    props: { ...w, href: `/work/${slugify(w.data.title)}` },
    params: { slug: slugify(w.data.title) },
  }));
}

const {
  data: { title, description, poster, media, categories },
} = Astro.props;
---

<Layout title={title}>
  <Nav />
  <SectionHeader>
    <Container classes={["px-6", "lg:px-0"]}>
      <a href="/work">
        <span class="text-2xl text-gray-700 font-light mb-8 lg:text-3xl block">
          &larr; Back to Work
        </span>
      </a>
      <h1 class="text-4xl text-gray-800 font-bold mb-8 lg:text-6xl">
        {title}
      </h1>
      <p
        class="text-xl text-gray-700 font-light antialiased lg:text-2xl lg:max-w-4xl"
      >
        {description}
      </p>
    </Container>
  </SectionHeader>
  <Container classes={["px-6", "mt-16", "lg:px-0", "text-gray-800"]}>
    <video controls playsinline poster={poster} class="w-full aspect-video">
      {media.map((m) => <source src={m.src} type={m.type} />)}
      Your browser does not support the video tag.
    </video>
    <div class="flex items-center mt-4">
        <span class="p-2 me-2 text-lg">Categories:</span>
        <ul class="flex flex-wrap items-center text-gray-100 text-sm">
            {categories.map(c => (
                <li class="bg-gray-700 backdrop-opacity-10 rounded-3xl me-2">
                    <a class="p-2 inline-block" href=`/work/category/${slugify(c)}`>{c}</a>
                </li>
            ))}
        </ul>
    </div>
  </Container>
  <Footer />
</Layout>
