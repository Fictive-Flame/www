---
import Layout from "../../components/Layout.astro";
import VideoStructuredData from "../../components/VideoStructuredData.astro";
import Nav from "../../components/Nav.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Container from "../../components/Container.astro";
import Footer from "../../components/Footer.astro";
import { getImage } from "astro:assets";

import { getWork, slugify } from "../../utils/data";

export const prerender = true;

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((w) => ({
    props: { ...w, href: `/work/${slugify(w.data.title)}` },
    params: { slug: slugify(w.data.title) },
  }));
}

const {
  data: {
    title,
    pubDate,
    description,
    poster,
    media,
    categories,
    youtubeId,
    team,
    links,
  },
} = Astro.props;

const structuredData = {
  name: title,
  description,
  thumbnailUrl: poster,
  uploadDate: pubDate,
  contentUrl: youtubeId || media[0].src,
  productionCompany: {
    name: "Fictive Flame Media",
    url: `https://fictiveflame.co`,
    email: "hello@fictiveflame.co",
  },
};

const resized = await getImage({ src: poster, width: 850, height: 500 });
---

<Layout title={title}>
  <VideoStructuredData data={structuredData} slot="structured-data" />
  <Nav />
  <SectionHeader>
    <Container classes={["px-6", "lg:px-0"]}>
      <a href="/work">
        <span
          class="text text-gray-700 dark:text-gray-400 font-light mb-8 block underline underline-offset-2"
        >
          &larr; Back to Work
        </span>
      </a>
      <h1
        class="text-4xl text-gray-800 dark:text-gray-300 font-bold mb-8 lg:text-6xl"
      >
        {title}
      </h1>
      <p
        class="text-xl text-gray-700 dark:text-gray-200 font-light antialiased lg:text-2xl lg:max-w-6xl"
      >
        {description}
      </p>
    </Container>
  </SectionHeader>
  <Container
    classes={[
      "px-6",
      "mt-12",
      "grid",
      "grid-cols-1",
      "lg:grid-cols-12",
      "lg:gap-12",
      "lg:px-0",
      "text-gray-800",
    ]}
  >
    <div class="lg:col-span-9">
      {
        youtubeId ? (
          <media-controller class="relative w-full aspect-video mb-4 lg:mb-8">
            <youtube-video
              slot="media"
              class="absolute w-full h-full aspect-video"
              src={`https://www.youtube.com/watch?v=${youtubeId}&hd=1`}
            />
            <media-control-bar class="w-full bottom-0 absolute">
              <media-play-button class="p-2" />
              <media-mute-button />
              <media-volume-range />
              <media-time-range />
              <media-fullscreen-button class="p-2" />
            </media-control-bar>
          </media-controller>
        ) : (
          <video
            controls
            playsinline
            poster={resized.src}
            class="w-full h-full aspect-video"
          >
            {media.map((m) => (
              <source src={m.src} type={m.type} />
            ))}
            Your browser does not support the video tag.
          </video>
        )
      }
    </div>
    <div class="text-gray-600 dark:text-gray-300 lg:col-span-3">
      <div class="mt-4 lg:mt-0 lg:col-span-3 uppercase text-sm">
        <div class="mb-4">
          <span class="text-base font-bold underline underline-offset-8"
            >Team</span
          >
        </div>
        <ul>
          {
            team.map((c) => (
              <li class="mb-4 antialiased">
                <span class="font-semibold block mb-1">{c.heading}</span>
                {c.credit}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mt-6 uppercase text-sm">
        <div class="mb-4">
          <span class="text-base font-bold underline underline-offset-8"
            >Links</span
          >
        </div>
        <ul class="flex flex-col dark:text-gray-300">
          {
            links.map((c) => (
              <li class="mb-1 antialiased">
                <a href={c.href} target="_blank" rel="noopener">
                  {c.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mt-6 uppercase text-sm">
        <div class="mb-4">
          <span class="text-base font-bold underline underline-offset-8"
            >Categories</span
          >
        </div>
        <ul class="flex dark:text-gray-300">
          {
            categories.map((c) => (
              <li class="me-4 antialiased">
                <a
                  class="hover:text-gray-400"
                  href={`/work/category/${slugify(c)}`}
                >
                  {c}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
  <Footer />
</Layout>
