---
import { getCollection } from "astro:content";
import { basename } from "path";
import { getWork, slugify } from "../../utils/data";
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map(w => ({
    params: { slug: slugify(w.data.title) },
    props: w,
  }))
}

const { data: { title, preview } } = Astro.props;
---
<Layout>
    <div class="relative w-full h-[45rem]">
        <Nav classes={["z-40", "absolute"]}/>
            <div
                class="absolute w-screen h-full bottom-0 z-11 bg-gradient-to-b from-gray-950/40 to-gray-950/100"
            >
            </div>
            <video
                autoplay
                loop
                muted
                playsinline
                class="absolute z-10 inset-0 h-full w-full object-cover"
            >
                {preview.map(({ src, type }) => (
                  <source src={src} type={type}/>
                ))}
                Your browser does not support the video tag.
            </video>
    </div>
    <div class="container relative -mt-96 grid lg:grid-cols-12 lg:gap-4 text-gray-300 mx-auto px-2">
        <div class="lg:col-span-9">
            <h1 class="text-6xl font-bold z-12">{title}</h1>
        </div>
        <div class="lg:col-span-3">
            <h2 class="text-4xl text-gray-300 absolute z-12">Hey!</h2>
        </div>
    </div>
</Layout>
