---
import Layout from "../../components/Layout.astro";
import VideoStructuredData from "../../components/VideoStructuredData.astro";
import Nav from "../../components/Nav.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Container from "../../components/Container.astro";
import Footer from "../../components/Footer.astro";

import { getWork, slugify } from "../../utils/data";

export const prerender = true;

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((w) => ({
    props: { ...w, href: `/work/${slugify(w.data.title)}` },
    params: { slug: slugify(w.data.title) },
  }));
}

const {
  data: { title, pubDate, description, poster, media, categories },
} = Astro.props;

const structuredData = {
  name: title,
  description,
  thumbnailUrl: poster,
  uploadDate: pubDate,
  contentUrl: media[0].src,
  productionCompany: {
    name: "Fictive Flame Media",
    url: `https://fictiveflame.co`,
    email: "hello@fictiveflame.co",
  },
};
---

<Layout title={title}>
  <VideoStructuredData data={structuredData} slot="structured-data" />
  <Nav />
  <SectionHeader>
    <Container classes={["px-6", "lg:px-0"]}>
      <a href="/work">
        <span
          class="text text-gray-700 dark:text-gray-400 font-light mb-8 block underline underline-offset-2"
        >
          &larr; Back to Work
        </span>
      </a>
      <h1
        class="text-4xl text-gray-800 dark:text-gray-300 font-bold mb-8 lg:text-6xl"
      >
        {title}
      </h1>
      <p
        class="text-xl text-gray-700 dark:text-gray-200 font-light antialiased lg:text-2xl lg:max-w-6xl"
      >
        {description}
      </p>
    </Container>
  </SectionHeader>
  <Container classes={["px-6", "mt-12", "lg:px-0", "text-gray-800"]}>
    <video controls playsinline poster={poster} class="w-full aspect-video">
      {media.map((m) => <source src={m.src} type={m.type} />)}
      Your browser does not support the video tag.
    </video>
    <div class="mt-4 uppercase text-sm">
      <div class="mb-2 dark:text-gray-300"><span>Categories</span></div>
      <ul class="flex overflow-y-scroll dark:text-gray-300">
        {
          categories.map((c) => (
            <li class="me-4 font-semibold antialiased text-nowrap">
              <a
                class="hover:text-gray-400"
                href={`/work/category/${slugify(c)}`}
              >
                {c}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
  <Footer />
</Layout>
