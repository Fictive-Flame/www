---
import { getCollection } from "astro:content";
import { basename } from "path";
import { getWork, slugify } from "../../utils/data";
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map(w => ({
    params: { slug: slugify(w.data.title) },
    props: w,
  }))
}

const { data: { title, preview } } = Astro.props;
---
<Layout>
    <div class="absolute h-2/3 w-screen">
        <Nav classes={["z-40", "absolute"]}/>
        <div
            class="absolute w-screen h-2/3 bottom-1/3 z-11 bg-gradient-to-b from-gray-950/50 to-gray-950/100"
        >
        </div>
        <video
            autoplay
            loop
            muted
            playsinline
            class="absolute z-10 inset-0 h-full w-full object-cover"
        >
            {preview.map(p => (
              <source src={p.src} type={p.type} />
            ))}
            Your browser does not support the video tag.
        </video>
    </div>
    <div class="relative -mt-px-500">
        <h2 class="text-6xl text-gray-300">{title}</h2>
    </div>
</Layout>
