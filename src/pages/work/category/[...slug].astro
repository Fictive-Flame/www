---
import Layout from "../../../components/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Container from "../../../components/Container.astro";
import Footer from "../../../components/Footer.astro";
import WorkFeature from "../../../components/WorkFeature.astro";
import { getWork, getWorkByCategory, slugify } from "../../../utils/data";

export async function getStaticPaths() {
  const work = await getWork();
  return work.map(({ data: { categories }}) => {
    return categories.map(c => ({
      props: { title: c },
      params: { slug: slugify(c) }
    }));
  }).flat()
}

const work = await getWorkByCategory(Astro.props.title);
const { title } = Astro.props;
---
<Layout primary>
    <Nav classes={["z-40"]}/>
    <Container>
        <div class="p-2 mt-12">
            <a href="/work">
            <h2 class="inline-block text-gray-400 text-6xl lg:text-7xl font-bold mb-8 underline">Work/</h2>
            </a>
            <h1 class="text-gray-300 text-6xl lg:text-7xl font-bold mb-8">{title}</h1>
        </div>
    </Container>
    <div class="container mx-auto grid mt-12 px-2 lg:grid-cols-2 lg:mb-6 lg:gap-8">
        {work.map(w => (<WorkFeature {...w}/>))}
    </div>
    <Footer/>
</Layout>
