---
import Layout from "../../../components/Layout.astro";
import Nav from "../../../components/Nav.astro";
import SectionHeader from "../../../components/SectionHeader.astro";
import Container from "../../../components/Container.astro";
import WorkFeature from "../../../components/WorkFeature.astro";
import Footer from "../../../components/Footer.astro";

import { getWork, getWorkByCategory, slugify } from "../../../utils/data";

export async function getStaticPaths() {
  const work = await getWork();
  return work
    .map(({ data: { categories } }) => {
      return categories.map((c) => ({
        props: { title: c, href: `/work/category/${slugify(c)}` },
        params: { slug: slugify(c) },
      }));
    })
    .flat();
}

const work = await getWorkByCategory(Astro.props.title);
const { title, href } = Astro.props;
---

<Layout category={`${title} - Work`}>
  <Nav />
  <SectionHeader>
    <Container classes={["px-6", "lg:px-0"]}>
      <a href="/work">
        <span class="text-2xl text-gray-700 font-light mb-8 lg:text-3xl block">
          &larr; Back to Work
        </span>
      </a>
      <span class="flex text-4xl text-gray-700 font-bold mb-8 lg:text-8xl">
        <a class="underline underline-offset-4" href="/work"><h2>Work</h2></a>/
        <a href={href}>
          <h1 class="text-gray-800">
            {title}
          </h1>
        </a>
      </span>
    </Container>
  </SectionHeader>
  <div class="mx-auto grid mt-16 grid-cols-12">
    {
      work.map((w) => (
        <div class="col-span-12 lg:col-span-6">
          <WorkFeature {...w} />
        </div>
      ))
    }
  </div>
  <Footer />
</Layout>
