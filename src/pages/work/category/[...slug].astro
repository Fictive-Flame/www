---
import Layout from "../../../components/Layout.astro";
import Nav from "../../../components/Nav.astro";
import SectionHeader from "../../../components/SectionHeader.astro";
import Container from "../../../components/Container.astro";
import WorkFeature from "../../../components/WorkFeature.astro";
import Footer from "../../../components/Footer.astro";

import {
  getWork,
  getWorkByCategory,
  getWorkCategories,
  slugify,
} from "../../../utils/data";

export const prerender = true;

export async function getStaticPaths() {
  return (await getWork())
    .map(({ data: { categories } }) => {
      return categories.map((c) => ({
        props: { title: c, href: `/work/category/${slugify(c)}` },
        params: { slug: slugify(c) },
      }));
    })
    .flat();
}

const work = await getWorkByCategory(Astro.props.title);
const categories = getWorkCategories(await getWork()).filter(
  (c) => c !== Astro.props.title,
);
const { title, href } = Astro.props;
---

<Layout title={`${title} - Work`}>
  <Nav />
  <SectionHeader>
    <Container classes={["px-6", "lg:px-0"]}>
      <a href="/work">
        <span
          class="text text-gray-700 dark:text-gray-400 font-light mb-8 block underline underline-offset-2"
        >
          &larr; Back to Work
        </span>
      </a>
      <span
        class="flex text-4xl text-gray-700 dark:text-gray-300 font-bold mb-8 lg:text-8xl"
      >
        <a class="underline underline-offset-4" href="/work"><h2>Work</h2></a>/
        <a href={href}>
          <h1 class="text-gray-800 dark:text-gray-400">
            {title}
          </h1>
        </a>
      </span>
    </Container>
  </SectionHeader>
  <div class="mx-auto grid mt-12 grid-cols-12">
    <Container
      classes={[
        "px-6",
        "lg:px-0",
        "col-span-12",
        "text-sm",
        "uppercase",
        "mb-2",
      ]}
    >
      <div class="mb-2 dark:text-gray-300"><span>Categories</span></div>
      <ul class="flex overflow-y-scroll dark:text-gray-300">
        {
          categories.map((c) => (
            <li class="me-4 font-semibold antialiased text-nowrap">
              <a
                class="hover:text-gray-400"
                href={`/work/category/${slugify(c)}`}
              >
                {c}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
    {
      work.map((w) => (
        <div class="col-span-12 lg:col-span-6">
          <WorkFeature {...w} />
        </div>
      ))
    }
  </div>
  <Footer />
</Layout>
