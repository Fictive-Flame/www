---
import Layout from "../../../components/Layout.astro";
import Nav from "../../../components/Nav.astro";
import SectionHeader from "../../../components/SectionHeader.astro";
import Container from "../../../components/Container.astro";
import WorkFeature from "../../../components/WorkFeature.astro";
import Footer from "../../../components/Footer.astro";

import { getWork, getWorkByCategory, slugify } from "../../../utils/data";

export async function getStaticPaths() {
  const work = await getWork();
  return work
    .map(({ data: { categories } }) => {
      return categories.map((c) => ({
        props: { title: c, href: `/work/category/${slugify(c)}` },
        params: { slug: slugify(c) },
      }));
    })
    .flat();
}

const work = await getWorkByCategory(Astro.props.title);
const { title, href } = Astro.props;
---

<Layout>
  <Nav />
  <SectionHeader>
    <Container>
      <span class="flex text-gray-700 lg:text-8xl">
        <a href="/"><h2 class="text-4xl font-bold mb-8 lg:text-8xl">Work</h2></a
        >/
        <a href={href}>
          <h1 class="text-4xl text-gray-800 font-bold mb-8 lg:text-8xl">
            {title}
          </h1>
        </a>
      </span>
    </Container>
  </SectionHeader>
  <div class="mx-auto grid mt-16 grid-cols-12">
    {
      work.map((w) => (
        <div class="col-span-12 mt-4 lg:col-span-6 lg:mt-0">
          <WorkFeature {...w} />
        </div>
      ))
    }
  </div>
  <Footer />
</Layout>
