---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Container from "../../components/Container.astro";
import WorkFeature from "../../components/WorkFeature.astro";
import Footer from "../../components/Footer.astro";

import { getWork } from "../../utils/data";

const work = await getWork();
---

<Layout>
  <Nav />
  <SectionHeader>
    <Container classes={["px-6", "lg:px-0"]}>
      <h1 class="text-4xl text-gray-800 font-bold mb-8 lg:text-8xl">
        Featured Work
      </h1>
      <p
        class="text-xl text-gray-700 font-light antialiased lg:text-2xl lg:max-w-4xl"
      >
        From pre-production to the final cut, we're here every step of the way.
        Here are a few of our favorite recent productions.
      </p>
    </Container>
  </SectionHeader>
  <div class="mx-auto grid mt-16 grid-cols-12">
    {
      work.map((w) => (
        <div class="col-span-12 lg:col-span-6">
          <WorkFeature {...w} />
        </div>
      ))
    }
  </div>
  <Footer />
</Layout>
