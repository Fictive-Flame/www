---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Container from "../../components/Container.astro";
import WorkFeature from "../../components/WorkFeature.astro";
import Footer from "../../components/Footer.astro";

import { getWork } from "../../utils/data";

const work = await getWork();
---

<Layout>
  <Nav />
  <SectionHeader>
    <Container>
      <h1 class="text-4xl text-gray-800 font-bold mb-8 lg:text-8xl">Work</h1>
      <p class="text-xl text-gray-700 font-light antialiased lg:text-2xl">
        From pre-production to the final cut, we're here every step of the way.
        This is a rotating selection of our best work.
      </p>
    </Container>
  </SectionHeader>
  <Container classes={["flex", "grid"]}>
    {work.map((w) => <WorkFeature {...w} />)}
  </Container>
  <Footer />
</Layout>
