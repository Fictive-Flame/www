---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Container from "../../components/Container.astro";
import WorkFeature from "../../components/WorkFeature.astro";
import Footer from "../../components/Footer.astro";

import { getWork, getWorkCategories, slugify } from "../../utils/data";

const work = await getWork();
const categories = getWorkCategories(work);
---

<Layout title="Featured Work">
  <Nav />
  <SectionHeader>
    <Container classes={["px-6", "lg:px-0"]}>
      <h1 class="text-4xl text-gray-800 font-bold mb-8 lg:text-8xl">
        Featured Work
      </h1>
      <p
        class="text-2xl text-gray-700 font-light antialiased lg:text-3xl lg:max-w-6xl"
      >
        From pre-production to the final cut, we're here every step of the way.
        Here are a few of our favorite recent productions.
      </p>
    </Container>
  </SectionHeader>
  <div class="mx-auto grid mt-14 grid-cols-12">
    <Container
      classes={[
        "px-6",
        "lg:px-0",
        "col-span-12",
        "text-sm",
        "uppercase",
        "mb-2",
      ]}
    >
      <div class="mb-2"><span>Categories</span></div>
      <ul class="flex overflow-y-scroll">
        {
          categories.map((c) => (
            <li class="me-4 font-semibold antialiased text-nowrap">
              <a
                class="hover:text-gray-400"
                href={`/work/category/${slugify(c)}`}
              >
                {c}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
    {
      work.map((w) => (
        <div class="col-span-12 lg:col-span-6">
          <WorkFeature {...w} />
        </div>
      ))
    }
  </div>
</Layout>
<Footer />
