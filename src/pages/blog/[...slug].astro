---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Container from "../../components/Container.astro";
import Prose from "../../components/Prose.astro";
import Footer from "../../components/Footer.astro";
import { getPosts, getPost, formatDate } from "../../utils/data";

import { Image } from "astro:assets";
import { render } from "astro:content";

export async function getStaticPaths() {
  return (await getPosts()).map(({ id, data }) => ({
    props: { ...data },
    params: { slug: id || data.slug },
  }));
}

interface Props {
  title: string;
}

const entry = await getPost(Astro.params.slug);
const {
  title,
  description,
  pubDate,
  headerAlt,
  headerImage,
  headerCredit,
  headerLink,
} = entry.data;
const { Content } = await render(entry);
---

<Layout title={title} description={description} image={headerImage.src}>
  <Nav />
  <SectionHeader>
    <Container classes={["px-6", "lg:px-0"]}>
      <span
        class="flex text-4xl text-gray-700 dark:text-gray-300 font-bold mb-4 lg:mb-6 lg:text-8xl"
      >
        <a href={`/blog/${entry.id}`}>
          <h1 class="text-gray-800 dark:text-gray-300">{title}</h1>
        </a>
      </span>
      <span
        class="text-sm lg:text-lg uppercase font-semibold text-gray-600 antialiased dark:text-gray-400"
        >Published on:
        <time>{formatDate(pubDate)}</time>
      </span>
    </Container>
  </SectionHeader>
  <div class="container mx-auto px-6 lg:px-0 mt-8">
    <Image
      src={headerImage}
      class="max-h-[600px] w-full object-cover rounded-2xl mb-2"
      alt={headerAlt ? headerAlt : "Header image for this blog entry"}
      width="1920"
      height="600"
      inferSize={true}
    />
    <span class="text-xs lg:text-sm text-gray-400"
      ><a href={headerLink}>{headerCredit}</a></span
    >
  </div>
  <div class="mx-auto px-6 container mt-8 lg:mt-12 max-w-3xl lg:px-0">
    <Prose>
      <Content />
    </Prose>
  </div>
  <Footer />
</Layout>
