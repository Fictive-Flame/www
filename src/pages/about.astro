---
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Container from "../components/Container.astro";
---
<Layout primary>
    <Nav classes={["z-40"]}/>
    <Container>
        <div class="p-2 mt-12">
            <h1 class="text-gray-300 text-7xl font-bold mb-8">Who We Are</h1>
            <p class="text-gray-300 text-xl">We've been here since media on the internet was possible. 240p to 4K, our pixels stay online.</p>
        </div>
    </Container>
</Layout>
