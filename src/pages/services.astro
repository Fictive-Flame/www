---
import Layout from "../components/Layout.astro";
import Nav from "..//components/Nav.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
import VWindow from "../components/VWindow.astro";
import { getWorkSections } from "../utils/data";

const sections = await getWorkSections();
const features = sections
  .filter((s) => s.data.type === "feature")
  .map((v) => ({ [v.data.title]: v.data.description }))
  .reduce((a, v) => ({ ...a, ...v }));

const media = {
  discovery: {
    media: [
      {
        type: "video/mp4",
        src: "https://storage.fictiveflame.co/pottery-turning.mp4",
      },
    ],
  },
  strategy: {
    media: [
      {
        type: "video/mp4",
        src: "https://storage.fictiveflame.co/nintendo.mp4",
      },
    ],
  },
  create: {
    media: [
      {
        type: "video/mp4",
        src: "https://storage.fictiveflame.co/snow.mp4",
      },
    ],
  },
  launch: {
    media: [
      {
        type: "video/mp4",
        src: "https://storage.fictiveflame.co/lights.mp4",
      },
    ],
  },
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<Layout
  title="Services"
  description="Video strategy, live streaming, production, and visual design. Come explore our world."
  canonical={canonicalURL}
>
  <Nav />
  <SectionHeader>
    <Container classes={["px-6", "lg:px-0"]}>
      <h1
        class="text-4xl text-gray-800 dark:text-gray-300 font-bold mb-8 lg:text-8xl"
      >
        Services
      </h1>
      <p
        class="text-2xl text-gray-700 dark:text-gray-200 font-light antialiased lg:text-3xl lg:max-w-6xl"
      >
        What we do here at Fictive Flame is pretty special. We're one half film
        and design, the other is an engineering firm. See what happens when art
        and science mix.
      </p>
    </Container>
  </SectionHeader>
  <Container
    classes={[
      "px-6",
      "mt-12",
      "lg:px-0",
      "text-gray-800",
      "dark:text-gray-300",
      "grid",
      "grid-cols-1",
      "lg:grid-cols-12",
      "lg:gap-12",
    ]}
  >
    <div
      class="bg-gray-50 dark:bg-gray-950 rounded-2xl shadow-lg p-6 col-span-1 lg:col-span-12"
      x-data="{ selected: 'Strategy' }"
    >
      <ul
        class="flex justify-center mb-10 space-x-2 text-nowrap overflow-y-scroll"
      >
        <li>
          <button
            @click="selected = 'Strategy'"
            class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer"
            :class="selected === 'Option 1' ? 'bg-gray-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'"
            >Strategy</button
          >
        </li>
        <li>
          <button
            @click="selected = 'Live Streaming'"
            class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer"
            :class="selected === 'Option 2' ? 'bg-gray-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'"
            >Live Streaming</button
          >
        </li>
        <li>
          <button
            @click="selected = 'Production'"
            class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer"
            :class="selected === 'Option 3' ? 'bg-gray-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'"
            >Production</button
          >
        </li>
        <li>
          <button
            @click="selected = 'Color Grading'"
            class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer"
            :class="selected === 'Option 3' ? 'bg-gray-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'"
            >Color Grading</button
          >
        </li>
        <li>
          <button
            @click="selected = 'Design and Delivery'"
            class="px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer"
            :class="selected === 'Option 3' ? 'bg-gray-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'"
            >Design and Delivery</button
          >
        </li>
      </ul>
      <div class="flex flex-col">
        <h2
          class="text-3xl lg:text-5xl w-full font-bold text-gray-900 dark:text-gray-300 text-center mb-2"
          x-text="selected"
        >
        </h2>
        <div
          class="w-full text-gray-800 dark:text-gray-200 text-xl antialiased font-light min-h-40 max-w-4xl mx-auto mt-8 text-center lg:text-2xl"
        >
          <template x-if="selected === 'Strategy'">
            <div x-transition>
              <p>
                Modern video production is complex: you need vertical and
                horizontal formats, optimized for each channel where they're
                being published. Good news is we've been doing this a long time,
                and we're here to make a plan.
              </p>
            </div>
          </template>
          <template x-if="selected === 'Live Streaming'">
            <div x-transition>
              <p>
                Our unique approach make it just as easy to stream as it does to
                record cinema-grade images and our cloud engineering expertise
                ensures your viewers can reliably tune in from around the world.
              </p>
            </div>
          </template>
          <template x-if="selected === 'Production'">
            <div x-transition>
              <p>
                From the first frame to final render, our editing and
                post-production workflow utilizes latest versions of DaVinci
                Resolve, Final Cut Pro, and Logic Pro. We also work in a
                professionally treated, acoustically flat studio.
              </p>
            </div>
          </template>
          <template x-if="selected === 'Color Grading'">
            <div x-transition>
              <p>
                Whether you're ingesting footage from multiple cameras or
                building a world out of stock footage, our color grading
                expertise can help all of your scenes live in the same visual
                world.
              </p>
            </div>
          </template>
          <template x-if="selected === 'Design and Delivery'">
            <div x-transition>
              <p>
                While creating engaging videos for the web is the primary goal,
                our team designed and built this website, too. We're multimedia
                artisans, and if you're missing a place that showcases your
                work, let's talk. We offer design consultation and art direction
                to compliment our other specialities.
              </p>
            </div>
          </template>
        </div>
      </div>
    </div>
    <div class="col-span-1 my-12 text-center lg:my-8 lg:col-span-12">
      <h3
        class="text-5xl text-gray-600 dark:text-gray-300 font-bold lg:text-6xl"
      >
        Our Process
      </h3>
    </div>
    <div
      class="col-span-1 order-1 mb-12 lg:mt-0 lg:col-span-8 lg:flex lg:items-center"
    >
      <div>
        <h3 class="text-wrap text-3xl font-medium mb-8 lg:text-4xl">
          Conversation and Discovery
        </h3>
        <p
          class="text-wrap text-xl text-gray-700 dark:text-gray-200 font-light antialiased lg:text-2xl"
        >
          Whether you're launching a new product, looking for a deep-dive
          explainer, or kicking off a long documentary project, the journey all
          begins with where you are.
        </p>
        <p
          class="text-wrap text-xl text-gray-700 dark:text-gray-200 font-light antialiased mt-8 lg:text-2xl"
        >
          Maybe you need more than a video. That's okay, we're a full
          interactive design firm. Either way, we're working to understand your
          goals, concerns, and passions before proposing any creative direction.
        </p>
      </div>
    </div>
    <div class="col-span-1 order-2 lg:col-span-4">
      <VWindow data={media.discovery} rounded />
    </div>
    <div class="col-span-1 order-4 mt-12 lg:mt-0 lg:order-3 lg:col-span-4">
      <VWindow data={media.strategy} rounded />
    </div>
    <div
      class="grid-span-1 order-3 flex items-center mt-12 lg:mt-0 lg:order-4 lg:col-span-8"
    >
      <div>
        <h3 class="text-wrap text-3xl font-medium mb-8 lg:text-4xl">
          Pre-Production
        </h3>
        <p
          class="text-wrap text-xl text-gray-700 dark:text-gray-200 font-light antialiased lg:text-2xl"
        >
          Using your story as fuel, we'll create a marketing and production plan
          that outlines the project goals and defines a clear roadmap to
          success.
        </p>
        <p
          class="text-wrap text-xl text-gray-700 dark:text-gray-200 font-light antialiased mt-8 lg:text-2xl"
        >
          If this is your first time using interactive or video marketing, don't
          worry. From the days of dial-up to high definition, our team has
          consistently been at the front of online media publishing. We'll be
          right there beside you, crunching the numbers and ensuring your pixels
          are bright and colorful.
        </p>
      </div>
    </div>
    <div
      class="grid-span-1 order-5 flex items-center mt-12 lg:mt-0 lg:col-span-8"
    >
      <div>
        <h3 class="text-wrap text-3xl font-medium mb-8 lg:text-4xl">
          Frame by Frame
        </h3>
        <p
          class="text-wrap text-xl text-gray-700 dark:text-gray-200 font-light antialiased lg:text-2xl"
        >
          Once we've decided on a destination, we gather the team, gear, and
          budget. We operate lean and take you behind the process at every
          chance.
        </p>
        <p
          class="text-wrap text-xl text-gray-700 dark:text-gray-200 font-light antialiased mt-8 lg:text-2xl"
        >
          After any revisions are done, we'll render a final version to ensure
          colors, contrast, interaction, and every other creative decision is
          perfect for your approval.
        </p>
      </div>
    </div>
    <div class="col-span-1 order-6 mt-12 lg:mt-0 lg:col-span-4">
      <VWindow data={media.create} rounded />
    </div>
    <div class="col-span-1 order-last mt-12 lg:order-7 lg:col-span-4 lg:mt-0">
      <VWindow data={media.launch} rounded />
    </div>
    <div
      class="grid-span-1 order-8 mt-12 lg:col-span-8 lg:flex lg:mt-0 lg:items-center"
    >
      <div>
        <h3 class="text-wrap text-3xl font-medium mb-8 lg:text-4xl">
          Countdown to Launch
        </h3>
        <p
          class="text-wrap text-xl text-gray-700 dark:text-gray-200 font-light antialiased lg:text-2xl"
        >
          Whether it's a three-day or three-year engagement, we've got
          experience running projects of all sizes. Our digital production team
          will ensure you have all of the assets you need; whether that's
          streaming live to the world, or uploading to your social channels.
        </p>
        <p
          class="text-wrap text-xl text-gray-700 dark:text-gray-200 font-light antialiased mt-8 lg:text-2xl"
        >
          We can handle clearance and deliver the finished project to you, or
          distribute it as a service. Because after all, we're here to keep your
          creative spark alight.
        </p>
      </div>
    </div>
  </Container>
  <Footer />
</Layout>
