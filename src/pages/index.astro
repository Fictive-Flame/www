---
import "../styles/global.css";
import poster from "../assets/background-poster.jpg";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Fictive Flame Media</title>
    </head>
    <body class="bg-gray-950">
        <div class="relative h-screen w-screen overflow-hidden">
            <div
                class="absolute w-screen h-96 bottom-0 z-12 bg-gradient-to-b from-gray-950/0 to-gray-950/100"
            >
            </div>
            <video
                autoplay
                loop
                muted
                poster={poster.src}
                class="absolute z-10 inset-0 h-full w-full object-cover"
            >
                <source
                    src="https://storage.fictiveflame.co/background-hd.mov"
                    type="video/mp4"
                />
                Your browser does not support the video tag.
            </video>
        </div>
        <div class="py-2 max-w-x2l mx-auto text-gray-50 font-humanist my-8">
            <h1 class="text-6xl text-center font-bold">Fictive Flame</h1>
            <p class="text-center mt-2">
                Denver, Colorado-based full-service media production.
            </p>
            <p class="text-center my-4 mx-auto max-w-sm">
                <a
                    class="block p-4 outline-solid outline-gray-100 rounded"
                    data-umami-event="Contact Link"
                    href="mailto:contact@fictiveflame.co">Contact</a
                >
            </p>
        </div>
    </body>
</html>
