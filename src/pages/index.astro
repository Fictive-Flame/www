---
import Layout from "../components/Layout.astro";
import Container from "../components/Container.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Layout>
    <div class="relative h-screen w-screen overflow-hidden">
        <Nav classes={["z-40", "absolute"]}/>
        <div class="flex h-screen">
            <div class="m-auto px-6 z-40 text-center">
                <h2 class="text-gray-200 text-5xl lg:text-8xl font-extrabold text-shadow-gray-700 text-shadow-lg mb-8">Lights. Camera. Loyalty.</h2>
                <p class="text-gray-200 text-xl lg:text-2xl text-shadow-gray-700 text-shadow-lg">Connect with fans and ignite your brand though engaging video production from Fictive Flame Media.</p>
            </div>
        </div>
        <div
            class="absolute w-screen h-2/3 bottom-0 z-12 bg-gradient-to-b from-gray-950/0 to-gray-950/100"
        >
        </div>
        <video
            autoplay
            loop
            muted
            playsinline
            class="absolute z-10 inset-0 h-full w-full object-cover"
        >
            <source
                src="https://storage.fictiveflame.co/background-hd-portfolio.mp4"
                type="video/mp4"
            />
            Your browser does not support the video tag.
        </video>
    </div>
    <Container>
        <div class="-mt-64 lg:-mt-16 z-20 flex flex-wrap relative font-neogrote text-gray-200 p-6">
            <div class="w-full mt-12 lg:w-1/3 lg:mt-0">
                <h2 class="text-4xl mb-6 font-bold">Featured Work</h2>
                <p class="text-wrap">
                    In today's world, stories are currency. From the first words though to the finished product, we can help you make an impact.
                </p>
            </div>
            <div class="w-full mt-12 lg:w-1/3 lg:mt-0 lg:px-6">
                <h2 class="text-4xl mb-6 font-bold">Capabilities</h2>
                <p class="text-wrap">Some may say art and science don't mix, but we can't see it any other way. Your project needs both, so why change now?</p>
            </div>
            <div class="w-full mt-12 lg:w-1/3 lg:mt-0">
                <h2 class="text-4xl mb-6 font-bold">Get In Touch</h2>
                <p class="text-wrap">
                    If you have an idea that's out of the ordinary, we want to hear it. Pitch your idea to a team who can see the future of storytelling.
                </p>
            </div>
        </div>
    </Container>
    <Footer/>
</Layout>
